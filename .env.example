# ============================================================
# TruthLens Environment Variables — EXAMPLE FILE
# ============================================================
# Copy this file to .env.local and fill in your keys.
# NEVER commit .env.local to GitHub.
# ============================================================

# Required: Get yours free at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Enables live web search. Get free at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Alternative search. Get free at https://serpapi.com
SERPAPI_API_KEY=your_serpapi_key_here
